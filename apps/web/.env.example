# Development env for `pnpm dev` (Next reads apps/web/.env.local).
#   cp apps/web/.env.example apps/web/.env.local
# Production uses docker/powder.env.example instead.

# docker compose -f docker-compose.dev.yml up -d   then   pnpm db:init
DATABASE_URL=postgres://powder:powder@localhost:5433/powder

# The dev server runs on port 3000 (apps/web/package.json).
BETTER_AUTH_URL=http://localhost:3000
# Session signing and OAuth-token encryption. Generate: openssl rand -hex 32
# Set it in dev too. `pnpm build` uses a throwaway secret when it is empty;
# production refuses to boot without a real one.
BETTER_AUTH_SECRET=
# AES-256-GCM key for deploy keys, webhook secrets and env vars (64 hex chars).
# Generate: openssl rand -hex 32
POWDER_ENCRYPTION_KEY=

# GitHub OAuth app, required to sign in locally: email signup is disabled and the
# first user comes from a GitHub login with the setup token (see CONTRIBUTING.md).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SSH key used to reach test servers (default ~/.ssh/id_ed25519).
# SSH_KEY_PATH=

# Every other setting is optional and documented in docker/powder.env.example.
