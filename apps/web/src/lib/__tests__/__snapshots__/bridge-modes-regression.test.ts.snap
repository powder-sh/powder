exports[`bridge modes without the dns-alias label (regression guard) > host-port mode with extra_hosts 1`] = `
{
  "changes": [
    "create --pull=never --name demo-powder-bridge --restart=no --memory 2g --memory-swap 2g --network shop_default --label powder.bridge=/opt/apps/demo|app --label com.docker.compose.project= --label com.docker.compose.service= --label com.docker.compose.version= --label com.docker.compose.project.config_files= --label com.docker.compose.project.working_dir= --label com.docker.compose.project.environment_file= --label com.docker.compose.oneoff= --label com.docker.compose.container-number= --label com.docker.compose.config-hash= --label com.docker.compose.depends_on= --label com.docker.compose.image= --label com.docker.compose.replace= --cap-drop NET_RAW --security-opt no-new-privileges --health-cmd test -f /tmp/.powder-ready --health-interval 1s --health-retries 1 --health-start-interval 1s --health-start-period 60s --label-file <tmp> --env-file <tmp> -v /opt/apps/demo/data:/data --user node --workdir /app --add-host host.docker.internal:host-gateway --cap-drop ALL --cap-drop NET_RAW --security-opt no-new-privileges:true --pids-limit 512 -p 127.0.0.1:13001:3001 sha256:abc",
    "start demo-powder-bridge",
    "exec demo-powder-bridge touch /tmp/.powder-ready",
    "exec demo-powder-bridge rm -f /tmp/.powder-ready",
    "stop -t 10 demo-powder-bridge",
    "rm -f demo-powder-bridge",
  ],
  "out": "[nginx] upstreams ok (no single primary without max_fails=0 next to a backup)
__POWDER_NGINXUP_reg1__ scan 
[bridge] nginx lists 127.0.0.1:13001 as a backup upstream
[bridge] demo-powder-bridge answering on 127.0.0.1:13001 (nginx backup upstream) - overlapping old and new during the swap
__POWDER_BRIDGE_reg1__ bridged
__POWDER_NGINXUP_reg1__ app ok
rc=0
[bridge] new container ready; draining bridge
[bridge] removed demo-powder-bridge
hrc=0
",
}
`;

