    k = index(rest, "/")
    if (k == 0) { c = rest; rest = "" } else { c = substr(rest, 1, k - 1); rest = substr(rest, k + 1) }
    if (c == "" || c == ".") continue
    if (c == "..") { if (sp == 0) return "!outside the repository"; sp--; continue }
