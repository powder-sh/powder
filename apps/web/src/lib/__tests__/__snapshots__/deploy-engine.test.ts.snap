  # value, so a ref using the name stays UNRESOLVED (fail closed, as argdecl does);
  # only a value that really expands to nothing is dropped.
  if (v ~ /[$]/) { UNR = 0; if (nstg) e = xpand(v, EX, 1, 0); else e = xpand(v, MA, 1, 0); if (UNR) e = v }
  addcand(k, e)
  if (!ob && nstg) SE[k] = e
