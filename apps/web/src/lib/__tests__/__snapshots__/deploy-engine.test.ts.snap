  r0 = $0; sub(/\\r$/, "", r0)
  if (index(r0, "\\r")) { bad("a carriage return inside a line (YAML reads it as a line break)"); next }
  if (r0 ~ ctl) { bad("a control character (only tab is allowed)"); next }
