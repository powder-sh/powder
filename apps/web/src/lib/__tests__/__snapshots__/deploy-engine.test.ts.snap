  k = toupper(substr(w, 1, length(w) - 1))
  n = split("FROM RUN CMD LABEL MAINTAINER EXPOSE ENV ADD COPY ENTRYPOINT VOLUME USER WORKDIR ARG ONBUILD STOPSIGNAL HEALTHCHECK SHELL", KWS, " ")
  for (i = 1; i <= n; i++)
