function rep(s) { print s > RP }
function hash(k,   cmd, h) {
  printf "%s\\n%s", ENVIRON["DFR_NS"], k > TF
  close(TF)
  cmd = "sha256sum < \\"" TF "\\""
  h = ""
  cmd | getline h
  close(cmd)
