  if (index(src, "\\\\") || index(src, "'\\''")) return "quoted or escaped (write it plainly)"
  if (!json && index(src, "\\"")) return "quoted or escaped (write it plainly)"
  t = tolower(src); gsub(/["\\[\\],]/, "", t)
