  if (v ~ /^[ \\t]*(-[ \\t]+)*\\?([ \\t]|$)/ || v ~ /[{,\\[][ \\t]*\\?([ \\t]|$)/) bad("an explicit (?) key")
  if (substr(l, 1, 1) == " ") { if (first) bad("the document root is indented"); first = 0; next }
  first = 0
  k = ""
  if (l ~ /^[A-Za-z0-9_.-]+[ \\t]*:([ \\t]|$)/) { k = l; sub(/[ \\t]*:.*$/, "", k) }
  else if (l ~ /^"[A-Za-z0-9_.-]+"[ \\t]*:([ \\t]|$)/ || l ~ /^'\\''[A-Za-z0-9_.-]+'\\''[ \\t]*:([ \\t]|$)/) { k = substr(l, 2); sub(/["'\\''][ \\t]*:.*$/, "", k) }
  else { bad("a top-level line that is not a plain key"); next }
  if (k == "include") bad("an include key")
}
END { exit rc }
' < "$2" 2>&1); then echo "compose file guard: refusing, $2 uses a compose or YAML form powder does not allow (include, extends, or a YAML form that could hide them; a hard refusal in every guard mode, see docs/SECURITY-COMPOSE.md):"; printf '%s\\n' "$CR_OUT" | head -n 5 | sed 's/^/  /'; CR_RC=1; fi; fi; shift 2; else shift; fi; done; return $CR_RC; }; cr_files -f '/opt/apps/demo/docker-compose.yml' $([ -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml' ] && printf '%s %s' -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml'); } || exit 1; EL_CFG=$(docker compose -f '/opt/apps/demo/docker-compose.yml' $([ -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml' ] && printf '%s %s' -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml') --profile '*' config --no-interpolate --format json 2>/dev/null) || { echo "env file guard: refusing, cannot read the compose config (docker compose config --no-interpolate failed), so the env_file / label_file paths cannot be checked. The compose error: $(docker compose -f '/opt/apps/demo/docker-compose.yml' $([ -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml' ] && printf '%s %s' -f '/var/lib/powder/compose/b3feb5b51c6e-demo/docker-compose.powder.yml') --profile '*' config --no-interpolate 2>&1 >/dev/null | head -c 500)"; exit 1; }; EL_OWN=$(readlink -f -- "$EL_OWNP" 2>/dev/null || true); EL_RP0=$(readlink -f -- "$EL_L0" 2>/dev/null || true); [ -n "$EL_RP0" ] || EL_RP0=$EL_L0; EL_RP1=$(readlink -f -- "$EL_L1" 2>/dev/null || true); [ -n "$EL_RP1" ] || EL_RP1=$EL_L1; el_in() { if [ "$2" = / ]; then return 0; fi; case "$1" in "$2"|"$2"/*) return 0;; esac; return 1; }; EL_RB=$(readlink -f -- "$EL_LB" 2>/dev/null || true); [ -n "$EL_RB" ] || EL_RB=$EL_LB; EL_LIST=$(printf '%s\\n' "$EL_CFG" | LC_ALL=C awk '
function ind(s) { match(s, /^ */); return RLENGTH }
function val(s,   v) { v = s; sub(/^ *"[^"]*": */, "", v); sub(/,$/, "", v); return v }
function item(s,   v) { v = s; sub(/^ */, "", v); sub(/,$/, "", v); return v }
