function mountcheck(spec,   n, f, i, k, type) {
  if (spec ~ /["'\\'']/) { rep("REFUSE a --mount= flag with quotes is not supported (write it unquoted): --mount=" spec); return }
  n = split(spec, f, ",")
  type = "bind"
  for (i = 1; i <= n; i++) {
    k = fkey(f[i])
    if (k == "type") type = tolower(fval(f[i]))
