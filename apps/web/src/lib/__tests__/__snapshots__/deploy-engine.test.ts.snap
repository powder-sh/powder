if [ -n "$(powder_git -c safe.directory="$dir" ls-files -- docker-compose.powder.yml 2>/dev/null)" ]; then
  echo "refusing: the repo tracks docker-compose.powder.yml (a powder-owned name, never taken from a checkout)"
  bad=1
fi
exit $bad
