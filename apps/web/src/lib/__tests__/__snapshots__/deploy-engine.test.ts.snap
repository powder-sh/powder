exports[`buildDeployScript > matches the snapshot (ordinal / supersede script) 1`] = `
"set -e; LAST_STEP=start; step() { LAST_STEP="$1"; echo "── $1 ──"; }; el_guard() { { EL_APP='demo'; EL_L0='/opt/apps/demo'; EL_LB='/opt/apps'; EL_L1="$EL_LB/$EL_APP"; EL_OWNP="/opt/apps/$EL_APP.env"; { cr_files() { CR_RC=0; while [ $# -gt 0 ]; do if [ "$1" = -f ] && [ $# -gt 1 ]; then if [ ! -e "$2" ] && [ ! -L "$2" ]; then :; elif [ ! -f "$2" ] || [ ! -r "$2" ]; then echo "compose file guard: refusing, cannot read the compose file $2"; CR_RC=1; else case "$2" in *//*|*/./*|*/../*|*/.|*/..) CR_GEN=0;; '/var/lib/powder/compose'/*) CR_GEN=1;; *) CR_GEN=0;; esac; if ! CR_OUT=$(LC_ALL=C awk -v gen="$CR_GEN" '
function bad(m) { printf "line %d: %s\\n", NR, m; rc = 1 }
function values(l,   p, r) {
  if (match(l, /^[ \\t]*(-[ \\t]+)*([A-Za-z0-9_.\\/-]+|"[A-Za-z0-9_.\\/-]+"|'\\''[A-Za-z0-9_.\\/-]+'\\'')[ \\t]*:[ \\t]+/)) p = RLENGTH
