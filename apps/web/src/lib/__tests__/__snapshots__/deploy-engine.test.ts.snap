function norm(p,   rest, k, c, sp, st, i, out) {
  rest = p; sp = 0
  while (rest != "") {
    k = index(rest, "/")
    if (k == 0) { c = rest; rest = "" } else { c = substr(rest, 1, k - 1); rest = substr(rest, k + 1) }
    if (c == "" || c == ".") continue
    if (c == "..") { if (sp == 0) return "!"; sp--; continue }
