  if (v ~ /(^|[^A-Za-z0-9_-])extends["'\\'']?[ \\t]*:/) bad("an extends key")
  if (v ~ /"[^"]*\\\\[^"]*"[ \\t]*:/) bad("a double-quoted key with an escape sequence")
