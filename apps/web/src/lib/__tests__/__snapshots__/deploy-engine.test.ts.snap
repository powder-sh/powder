  else if (match(t, /^[A-Za-z0-9_.\\/@+-]+[ \\t]*:([ \\t]|$)/) || match(t, /^"[^"\\\\]*"[ \\t]*:([ \\t]|$)/) || match(t, /^'\\''[^'\\'']*'\\''[ \\t]*:([ \\t]|$)/)) {
