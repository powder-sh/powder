f == "volumes" && i == 8 && /^        \\}/ { if (vt == "\\"bind\\"" && !vro && vs != "") { if (vs ~ /^"[^"\\\\]*"$/) print "V " substr(vs, 2, length(vs) - 2); else print "BV " vs } next }
f == "volumes" { next }
i == 8 && /^        "/ { emit(item($0)); next }
i == 10 && /^          "path": / { emit(val($0)); next }
'); pw_wnorm() { PW_NP=$1; shift; while [ $# -ge 2 ]; do if [ "$1" != / ]; then case "$PW_NP" in "$1"|"$1"/*) printf '%s' "$2\${PW_NP#"$1"}"; return 0;; esac; fi; shift 2; done; printf '%s' "$PW_NP"; }; pw_wcollect() { PW_WHY=""; PW_B=""; PW_D=""; PW_VN=""; PW_IDS=$(docker ps -aq --filter "label=com.docker.compose.project" 2>/dev/null) || { PW_WHY="cannot list the containers on this server (docker ps failed)"; return 1; }; if [ -n "$PW_IDS" ]; then PW_B=$(printf '%s\\n' "$PW_IDS" | xargs docker inspect --format '{{range .Mounts}}{{if and (eq .Type "bind") .RW}}{{println .Source}}{{end}}{{end}}' 2>/dev/null) || { PW_WHY="cannot read the bind mounts of the containers on this server (docker inspect failed)"; return 1; }; PW_VN=$(printf '%s\\n' "$PW_IDS" | xargs docker inspect --format '{{range .Mounts}}{{if and (eq .Type "volume") .RW}}{{println .Name}}{{end}}{{end}}' 2>/dev/null) || { PW_WHY="cannot read the volume mounts of the containers on this server (docker inspect failed)"; return 1; }; fi; PW_VL=$(docker volume ls -q 2>/dev/null) || { PW_WHY="cannot list the volumes on this server (docker volume ls failed)"; return 1; }; PW_VN=$( { printf '%s\\n' "$PW_VN"; printf '%s\\n' "$PW_IN" | LC_ALL=C awk -F '\\t' '/^D / { print $NF }' | while IFS= read -r PW_V; do if printf '%s\\n' "$PW_VL" | grep -qxF -- "$PW_V"; then printf '%s\\n' "$PW_V"; fi; done; } | grep -E '^[A-Za-z0-9][A-Za-z0-9_.-]*$' | LC_ALL=C sort -u); if [ -n "$PW_VN" ]; then PW_D=$(printf '%s\\n' "$PW_VN" | xargs docker volume inspect --format '{{if .Options}}{{with index .Options "device"}}{{println .}}{{end}}{{end}}' 2>/dev/null) || { PW_WHY="cannot read the options of the volumes $(printf '%s' "$PW_VN" | tr '\\n' ' ')(docker volume inspect failed)"; return 1; }; fi; return 0; }; pw_wset() { PW_IN=$(cat); pw_wcollect || pw_wcollect || { printf 'PW_ERR %s\\n' "$PW_WHY"; return 1; }; { printf '%s\\n' "$PW_IN" | sed -n 's/^W //p'; printf '%s\\n' "$PW_B"; printf '%s\\n' "$PW_D"; } | while IFS= read -r PW_S; do case "$PW_S" in (/*) ;; (*) continue;; esac; case "$PW_S" in (*'$'*) continue;; esac; PW_S=$(printf '%s' "$PW_S" | tr -s /); PW_S=$(pw_wnorm "$PW_S" "$@"); PW_X=$(readlink -f -- "$PW_S" 2>/dev/null || true); printf '%s\\n' "\${PW_X:-$PW_S}"; done | LC_ALL=C sort -u; return 0; }; EL_BR=$(printf '%s\\n' "$EL_CFG" | LC_ALL=C awk '
