  USP = sprintf("%c%c|%c%c|%c%c%c|%c%c", 194, 133, 194, 160, 225, 154, 128, 226, 128) c "|" sprintf("%c%c%c|%c%c%c", 226, 129, 159, 227, 128, 128)
