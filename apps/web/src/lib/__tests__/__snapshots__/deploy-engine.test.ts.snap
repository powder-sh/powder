function join_add(line,   t) {
  if (line ~ /^[ \\t]*(#.*)?[\\r]?$/) return
  t = line
  if (contd(t)) {
    sub(/[ \\t]+$/, "", t)
    jbuf = (jcont ? jbuf : "") substr(t, 1, length(t) - 1)
