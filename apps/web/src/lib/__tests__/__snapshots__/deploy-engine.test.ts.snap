    why = "a YAML tag is not supported"; return 0
  }
  if (r ~ /^"/) {
    if (r ~ /^"([^"\\\\]|\\\\.)*"[ \\t]*(#.*)?$/) return 1
    why = (r ~ /^"([^"\\\\]|\\\\.)*"/) ? "text after a quoted string" : "a quoted string spanning lines is not supported"; return 0
  }
  if (r ~ /^'\\''/) {
    if (r ~ /^'\\''([^'\\'']|'\\'''\\'')*'\\''[ \\t]*(#.*)?$/) return 1
    why = (r ~ /^'\\''([^'\\'']|'\\'''\\'')*'\\''/) ? "text after a quoted string" : "a quoted string spanning lines is not supported"; return 0
  }
  if (r ~ /^[{\\[]/) return flowok(r)
  if (r ~ /^[%@]/) { why = "a reserved indicator"; return 0 }
  return 1
