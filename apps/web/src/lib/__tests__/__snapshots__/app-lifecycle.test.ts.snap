// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`remove command > a project name shared with another app: the app container by name only (snapshot) 1`] = `"bash -o pipefail -c '{ [ ! -L '\\''/var/lib/powder/locks'\\'' ] && mkdir -p '\\''/var/lib/powder/locks'\\'' && chmod 700 '\\''/var/lib/powder/locks'\\''; } || { echo "per-app lock dir unusable (a symlink or cannot be created), refusing"; exit 1; }; [ ! -L '\\''/var/lib/powder/locks/b2ca3d4dbbbeafca-zorbweb.lock'\\'' ] || { echo "per-app lock path is a symlink, refusing"; exit 1; }; exec 9>'\\''/var/lib/powder/locks/b2ca3d4dbbbeafca-zorbweb.lock'\\'' || exit 1; flock -w 90 9 || { echo "another deploy of this app holds the lock"; exit 1; }; RM='\\'''\\''; IDS=$(docker ps -aq --no-trunc --filter '\\''name=^/?zorbweb$'\\'') || { echo "could not list containers (docker ps failed), nothing removed"; exit 2; }; for I in $IDS; do RM="$RM $I"; done; GO='\\'''\\''; for I in $RM; do N=$(docker inspect --format '\\''{{.Name}}'\\'' "$I" 2>/dev/null) || continue; N=\${N#/}; [ -n "$N" ] || continue; case "$N" in '\\''quuxapi'\\''|'\\''powder'\\''|'\\''zorb.web'\\'') echo "kept $N (another app or powder itself)"; continue;; esac; GO="$GO $I"; echo "removed $N"; done; if [ -n "$GO" ]; then docker stop -t 30 $GO >/dev/null && docker rm -f $GO >/dev/null || { echo "docker stop / rm failed"; exit 1; }; fi; echo '\\''kept the other containers of the compose project zorbweb: zorb.web uses the same project name, only zorbweb was removed'\\''; echo __POWDER_APP_REMOVED__'"`;

exports[`remove command > own compose project: by name and project label, under the per-app lock 1`] = `"bash -o pipefail -c '{ [ ! -L '\\''/var/lib/powder/locks'\\'' ] && mkdir -p '\\''/var/lib/powder/locks'\\'' && chmod 700 '\\''/var/lib/powder/locks'\\''; } || { echo "per-app lock dir unusable (a symlink or cannot be created), refusing"; exit 1; }; [ ! -L '\\''/var/lib/powder/locks/b2ca3d4dbbbeafca-zorbweb.lock'\\'' ] || { echo "per-app lock path is a symlink, refusing"; exit 1; }; exec 9>'\\''/var/lib/powder/locks/b2ca3d4dbbbeafca-zorbweb.lock'\\'' || exit 1; flock -w 90 9 || { echo "another deploy of this app holds the lock"; exit 1; }; RM='\\'''\\''; IDS=$(docker ps -aq --no-trunc --filter '\\''name=^/?zorbweb$'\\'') || { echo "could not list containers (docker ps failed), nothing removed"; exit 2; }; for I in $IDS; do RM="$RM $I"; done; IDS=$(docker ps -aq --no-trunc --filter '\\''label=com.docker.compose.project=zorbweb'\\'') || { echo "could not list containers (docker ps failed), nothing removed"; exit 2; }; for I in $IDS; do case " $RM " in *" $I "*) continue;; esac; W=$(docker inspect --format '\\''{{index .Config.Labels "com.docker.compose.project.working_dir"}}'\\'' "$I" 2>/dev/null) || continue; if [ "$W" != '\\''/opt/apps/zorbweb'\\'' ]; then N=$(docker inspect --format '\\''{{.Name}}'\\'' "$I" 2>/dev/null); echo "kept \${N#/} (compose project zorbweb from another working dir: $W)"; continue; fi; RM="$RM $I"; done; GO='\\'''\\''; for I in $RM; do N=$(docker inspect --format '\\''{{.Name}}'\\'' "$I" 2>/dev/null) || continue; N=\${N#/}; [ -n "$N" ] || continue; case "$N" in '\\''quuxapi'\\''|'\\''powder'\\'') echo "kept $N (another app or powder itself)"; continue;; esac; GO="$GO $I"; echo "removed $N"; done; if [ -n "$GO" ]; then docker stop -t 30 $GO >/dev/null && docker rm -f $GO >/dev/null || { echo "docker stop / rm failed"; exit 1; }; fi; for W in $(docker network ls -q --filter '\\''label=com.docker.compose.project=zorbweb'\\'' 2>/dev/null); do docker network rm "$W" >/dev/null 2>&1 || true; done; echo __POWDER_APP_REMOVED__'"`;

exports[`stop command > is built from the validated name only 1`] = `"bash -o pipefail -c 'S=$(docker inspect --format '\\''{{.State.Running}}'\\'' -- zorbweb 2>/dev/null) || { echo "stop refused: no container named zorbweb on this server"; exit 1; }; if [ "$S" != true ]; then echo "already stopped: zorbweb is not running"; exit 0; fi; docker stop -t 30 -- zorbweb'"`;
