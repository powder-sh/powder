exports[`generated deploy script wiring > drain functions snapshot 1`] = `"drain_mark() { echo '__POWDER_STAB_drain1__'" stop-drain $1"; return 0; }; drain_rule() { if [ "$2" = host ]; then iptables -w 5 "$1" INPUT -i lo -p tcp -d 127.0.0.1 --dport "$3" --syn -m comment --comment "powder-drain 127.0.0.1:$3 $4 demo-app-3ca060d9e9" -j REJECT --reject-with tcp-reset; else nsenter -t "$5" -n iptables -w 5 "$1" INPUT -p tcp --dport "$3" --syn -m comment --comment "powder-drain netns:$3 $4 demo-app-3ca060d9e9" -j REJECT --reject-with tcp-reset; fi; }; drain_clear() { __dl=""; if [ "$1" = host ]; then command -v iptables >/dev/null 2>&1 || return 0; __dl=$(iptables -w 5 -S INPUT 2>/dev/null | grep -oE 'powder-drain 127[.]0[.]0[.]1:[0-9]+ [A-Za-z0-9]+ [A-Za-z0-9_-]+"' || true); else case "$2" in ''|0|*[!0-9]*) return 0 ;; esac; command -v nsenter >/dev/null 2>&1 || return 0; __dl=$(nsenter -t "$2" -n iptables -w 5 -S INPUT 2>/dev/null | grep -oE 'powder-drain netns:[0-9]+ [A-Za-z0-9]+ [A-Za-z0-9_-]+"' || true); fi; [ -n "$__dl" ] || return 0; printf '%s\\n' "$__dl" | sort -u | while read -r __x __a __t __r; do [ "$__r" = 'demo-app-3ca060d9e9"' ] || continue; __p="\${__a##*:}"; case "$__p" in ''|*[!0-9]*) continue ;; esac; case "$__t" in ''|*[!A-Za-z0-9]*) continue ;; esac; __n=0; while [ "$__n" -lt 20 ] && drain_rule -D "$1" "$__p" "$__t" "$2" >/dev/null 2>&1; do __n=$((__n+1)); done; done; return 0; }; drain_reaper() { [ "\${B_REAPER:-on}" = off ] && return 0; if [ "$1" = host ]; then __rc="iptables -w 5 -D INPUT -i lo -p tcp -d 127.0.0.1 --dport $2 --syn -m comment --comment 'powder-drain 127.0.0.1:$2 $3 demo-app-3ca060d9e9' -j REJECT --reject-with tcp-reset"; else __rc="nsenter -t $5 -n iptables -w 5 -D INPUT -p tcp --dport $2 --syn -m comment --comment 'powder-drain netns:$2 $3 demo-app-3ca060d9e9' -j REJECT --reject-with tcp-reset"; fi; if command -v setsid >/dev/null 2>&1; then ( setsid sh -c "sleep $4; $__rc" </dev/null >/dev/null 2>&1 7>&- 8>&- 9>&- & ); else ( nohup sh -c "sleep $4; $__rc" </dev/null >/dev/null 2>&1 7>&- 8>&- 9>&- & ); fi; return 0; }; drain_trap_first() { set +e; trap '' PIPE; drain_clear host >/dev/null 2>&1; if [ -n "$B_NSPID" ]; then drain_clear netns "$B_NSPID" >/dev/null 2>&1; fi; B_RULE=""; B_NSPID=""; if ! printf '\\n' 2>/dev/null; then B_DEAD=1; exec >/dev/null 2>&1; fi; return 0; }; bridge_refused() { curl -s -o /dev/null --max-time 3 "http://$1:$2/" >/dev/null 2>&1; [ "$?" = 7 ]; }; bridge_lo_http() { __lc=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:$1/" 2>/dev/null || true); case "$__lc" in [234][0-9][0-9]) return 0 ;; *) return 1 ;; esac; }; bridge_conns() { __cp=$(docker inspect -f '{{.State.Pid}}' "$1" 2>/dev/null || true); case "$__cp" in ''|0|*[!0-9]*) echo x; return 0 ;; esac; if ! command -v nsenter >/dev/null 2>&1 || ! command -v ss >/dev/null 2>&1; then echo x; return 0; fi; __ssl=$(nsenter -t "$__cp" -n ss -Htn state established "( sport = :$2 )" 2>/dev/null) || { echo x; return 0; }; printf '%s\\n' "$__ssl" | grep -c . || true; }; bridge_has_retry() { [ -n "$B_LF" ] && [ -f "$B_LF" ] || return 1; __rr=""; while IFS= read -r __l; do case "$__l" in traefik.http.routers.*.rule=*) __x="\${__l#traefik.http.routers.}"; __rr="$__rr \${__x%%.rule=*}" ;; esac; done < "$B_LF"; [ -n "$__rr" ] || return 1; for __r in $__rr; do case "$__r" in *[!A-Za-z0-9_-]*) return 1 ;; esac; __ok=0; __ms=""; while IFS= read -r __l; do case "$__l" in "traefik.http.routers.$__r.middlewares="*) __ms="\${__l#*=}" ;; esac; done < "$B_LF"; for __m in $(printf '%s' "$__ms" | tr ',' ' '); do __m="\${__m%@docker}"; case "$__m" in ''|*[!A-Za-z0-9_-]*) continue ;; esac; while IFS= read -r __l; do case "$__l" in "traefik.http.middlewares.$__m.retry.attempts="*) __v="\${__l#*=}"; case "$__v" in ''|*[!0-9]*|0*|1) ;; *) __ok=1 ;; esac ;; esac; done < "$B_LF"; done; [ "$__ok" = 1 ] || return 1; done; return 0; }; bridge_restore_old() { if [ -z "$B_OLD" ] || [ "\${SWAPPED:-0}" = 1 ]; then return 0; fi; if docker inspect "$B_OLD" >/dev/null 2>&1 && [ "$(docker inspect -f '{{.State.Running}}' "$B_OLD" 2>/dev/null)" != true ]; then if docker start "$B_OLD" >/dev/null 2>&1; then echo "[drain] the deploy stopped after the old container was stopped: started it again"; bridge_wait 60 "$B_OLD" "$B_PORT" bridge_http || true; else echo "[drain] WARNING: could not start the old container again"; fi; fi; B_OLD=""; return 0; }; bridge_drain_old() { B_OLD=""; if [ -z "$BRIDGE" ] || ! docker inspect "$BRIDGE" >/dev/null 2>&1; then return 0; fi; __o=$(docker compose -f 'c.yml' ps -q 'app' 2>/dev/null | head -1 || true); if [ -z "$__o" ] || [ "$(docker inspect -f '{{.State.Running}}' "$__o" 2>/dev/null)" != true ]; then return 0; fi; __g=$(docker inspect -f '{{.Config.StopTimeout}}' "$__o" 2>/dev/null || true); case "$__g" in ''|0|*[!0-9]*) __g=30 ;; esac; if [ "\${#__g}" -gt 3 ] || [ "$__g" -gt 600 ]; then __g=600; fi; __g=$(cap "$__g" 120); B_DRAIN_G="$__g"; __bok=0; if [ -n "$B_HP" ]; then bridge_lo_http "$B_HP" && __bok=1; else bridge_http "$BRIDGE" "$B_PORT" && __bok=1; fi; if [ "$__bok" != 1 ]; then echo "[drain] WARNING: the bridge is not answering: compose stops the old container as before"; drain_mark no-route-away; return 0; fi; __ra=0; __why=""; __pid=$(docker inspect -f '{{.State.Pid}}' "$__o" 2>/dev/null || true); B_RTOK="d$(date +%s)$$"; if [ -n "$B_HP" ]; then if [ -z "$B_AHP" ] || ! command -v iptables >/dev/null 2>&1; then __why="iptables is not installed"; elif drain_rule -I host "$B_AHP" "$B_RTOK" >/dev/null 2>&1; then B_RULE="$B_AHP"; drain_reaper host "$B_AHP" "$B_RTOK" "\${B_REAP_SEC:-$((__g + 240))}"; if bridge_refused 127.0.0.1 "$B_AHP"; then __ra=1; else drain_clear host; B_RULE=""; __why="the reject rule did not take effect (a probe of 127.0.0.1:$B_AHP still connected)"; fi; else __why="the reject rule could not be inserted"; fi; elif [ -z "$B_DNS" ] && ! bridge_has_retry; then __why="its Traefik router has no retry middleware (powder renders <app>-retry; hand-written labels need one), so Traefik would not re-send a refused request"; else __oip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "$__o" 2>/dev/null | awk '{print $1}'); case "$__pid" in ''|0|*[!0-9]*) __why="no process id for the old container" ;; *) if [ -z "$__oip" ] || ! command -v nsenter >/dev/null 2>&1; then __why="nsenter is not installed or the old container has no IP"; elif drain_rule -I netns "$B_PORT" "$B_RTOK" "$__pid" >/dev/null 2>&1; then B_NSPID="$__pid"; drain_reaper netns "$B_PORT" "$B_RTOK" "\${B_REAP_SEC:-$((__g + 60))}" "$__pid"; if bridge_refused "$__oip" "$B_PORT"; then __ra=1; else drain_clear netns "$__pid"; B_NSPID=""; __why="the reject rule did not take effect (a probe of $__oip:$B_PORT still connected)"; fi; else __why="the reject rule could not be inserted in the container's network namespace"; fi ;; esac; fi; if [ "$__ra" = 1 ]; then if [ -n "$B_HP" ]; then echo "[drain] new connections to 127.0.0.1:$B_AHP refused: nginx sends them to the bridge (backup upstream)"; elif [ -n "$B_DNS" ]; then echo "[drain] new connections to the old container refused: the proxy retries them on the next address (the bridge)"; else echo "[drain] new connections to the old container refused: Traefik's retry middleware re-sends them to the bridge"; fi; else echo "[drain] WARNING: not refusing new connections to the old container: $__why. A request that reaches it while it stops can fail"; drain_mark no-route-away; fi; __idle=n; __nc=""; __iw="$__g"; if [ -z "$B_HP$B_DNS" ] && [ "$__iw" -gt 5 ]; then __iw=5; fi; __w0=$(date +%s); if [ "$__ra" = 1 ]; then while :; do __nc=$(bridge_conns "$__o" "$B_PORT"); case "$__nc" in 0) __idle=y; break ;; ''|*[!0-9]*) __nc=x; break ;; esac; if [ "$(( $(date +%s) - __w0 ))" -ge "$__iw" ]; then break; fi; sleep 0.2; done; fi; __st="$__g"; if [ "$__idle" = y ]; then __st=10; echo "[drain] old container idle (no open connection on :$B_PORT) after $(( $(date +%s) - __w0 ))s"; elif [ "$__nc" = x ]; then echo "[drain] could not count the old container's open connections (nsenter or ss missing): SIGTERM with the full grace"; elif [ -n "$B_HP$B_DNS" ] && [ "$__ra" = 1 ]; then __st=10; echo "[drain] old container still has open connections after \${__g}s"; fi; B_OLD="$__o"; __t0=$(date +%s); echo "[drain] stopping the old container (SIGTERM, then SIGKILL after \${__st}s)"; docker stop -t "$__st" "$__o" >/dev/null 2>&1 || true; __dt=$(( $(date +%s) - __t0 )); B_NSPID=""; __ec=$(docker inspect -f '{{.State.ExitCode}}' "$__o" 2>/dev/null || true); if [ "$__ec" = 137 ]; then if [ "$__idle" = y ]; then echo "[drain] WARNING: the old container ignored SIGTERM and was killed after \${__st}s (it was idle: no request lost); its PID 1 does not pass SIGTERM to the server: use an exec-form CMD (CMD [\\"node\\", \\"server.js\\"]) or exec in the start script"; drain_mark sigterm-ignored; else echo "[drain] WARNING: the old container was killed after \${__st}s with connections open or uncounted: requests in flight may have been cut (PID 1 not passing SIGTERM on, a proxy reusing keep-alive connections to it, or a request longer than stop_grace_period)"; drain_mark killed; fi; elif [ "$__idle" = y ]; then echo "[drain] old container stopped \${__dt}s after SIGTERM (exit \${__ec:-?}), with no request in flight"; if [ "$__ra" = 1 ]; then drain_mark ok; fi; else echo "[drain] old container stopped \${__dt}s after SIGTERM (exit \${__ec:-?})"; if [ "$__ra" = 1 ]; then drain_mark ok; fi; fi; return 0; }; "`;
